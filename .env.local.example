# Supabase project credentials — copy this file to .env.local and fill in.
# Find both values in the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — powers AI brief generation at /intake (Step 4+).
# Without it, a deterministic local parser is used instead (same flow).
OPENAI_API_KEY=
# OPENAI_BRIEF_MODEL=gpt-4o-mini

# Optional — Sentry error tracking (Step 14+). From sentry.io: Project
# Settings → Client Keys (DSN). Unset = tracking fully inactive.
# SENTRY_DSN=

# Optional — invite email (Step 23, plain SMTP via the owner's own
# mail account). ALL FIVE must be set for invites to be emailed; any
# missing = silently skipped (copy-link flow, dev mode).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<App Password — regular passwords are rejected by Google>.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NookScript <you@gmail.com>"

# Optional — shared rate-limit store (Step 24, Upstash Redis REST).
# BOTH must be set for the /share|/invite|/invoice/ caps to share
# counters across deploys and instances; either missing = the Step 14
# in-memory window (dev mode, unchanged). From the Upstash console:
# the database's REST URL + REST token.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

