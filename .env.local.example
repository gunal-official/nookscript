# Supabase project credentials — copy this file to .env.local and fill in.
# Find both values in the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — powers AI brief generation at /intake (Step 4+).
# Without it, a deterministic local parser is used instead (same flow).
OPENAI_API_KEY=
# OPENAI_BRIEF_MODEL=gpt-4o-mini

# Optional — Sentry error tracking (Step 14+). From sentry.io: Project
# Settings → Client Keys (DSN). Unset = tracking fully inactive.
# SENTRY_DSN=

# Optional — invite email (Step 23, plain SMTP via the owner's own
# mail account). ALL FIVE must be set for invites to be emailed; any
# missing = silently skipped (copy-link flow, dev mode).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<App Password — regular passwords are rejected by Google>.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NookScript <you@gmail.com>"


# Optional — Stripe billing for the Free → Pro upgrade (2026-09-26
# events/webhooks/billing phase; GLOBAL product — multi-currency).
# TEST-mode keys in development.
# STRIPE_SECRET_KEY + STRIPE_PRICES: the in-app "Upgrade to Pro" button
# (hosted Stripe Checkout). STRIPE_PRICES is a JSON array with ONE
# recurring (monthly) price per currency you offer — create each price
# in the Stripe dashboard (cards accepted in 135+ currencies worldwide)
# and list them, e.g.:
#   [{"currency":"USD","priceId":"price_...","amount":19},
#    {"currency":"EUR","priceId":"price_...","amount":17},
#    {"currency":"INR","priceId":"price_...","amount":1499}]
# `amount` = display value in major units; it must match the Stripe
# price. With 2+ currencies the owner picks before checkout.
# STRIPE_WEBHOOK_SECRET + SUPABASE_SERVICE_ROLE_KEY: the
# /api/stripe/webhook endpoint (exactly two events:
# checkout.session.completed + customer.subscription.deleted).
# Any of these missing = the Plan card keeps the early-access mailto and
# nothing breaks. Full setup: docs/billing-webhooks-closeout.md.
# STRIPE_SECRET_KEY=
# STRIPE_PRICES=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — outbound-webhook retry sweep (serverless recovery for
# frozen in-process retries). Point any scheduler once per minute at:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-domain>/api/cron/webhooks
# Unset = the route returns 503 and the sweep never runs.
# CRON_SECRET=

# Google SSO: NO app-side env vars. "Continue with Google" on /login and
# /signup needs only the Google provider enabled in the Supabase
# dashboard (Authentication → Providers → Google) with the app origin in
# the OAuth client's redirect URIs — see README "Google SSO" and
# docs/sso-closeout.md. If the provider is not enabled, the button shows
# an inline error instead of failing silently.

# Gmail/Outlook mailbox intake (all optional — Settings → Mailbox shows
# an actionable "set these env" state when any are missing; the rest of
# the app is unaffected):
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — Google Cloud OAuth client
#     (Web application) with the Gmail API enabled; add the app origin's
#     /api/email/callback to its redirect URIs. Read-only scope
#     (gmail.readonly) — the app never sends mail.
#   AZURE_CLIENT_ID / AZURE_CLIENT_SECRET (+ optional AZURE_TENANT_ID,
#     default "common") — app registration with Microsoft Graph
#     Mail.Read (delegated); same /api/email/callback redirect URI.
#   EMAIL_TOKEN_ENCRYPTION_KEY — 64 hex chars (openssl rand -hex 32):
#     AES-256-GCM key for the stored tokens. Never stored in the DB.
# Optional cron sweep (same CRON_SECRET as the webhook sweep's pattern,
# but its own route): POST https://<your-domain>/api/cron/email — syncs
# every connected mailbox. Full setup: docs/email-intake-closeout.md.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# EMAIL_TOKEN_ENCRYPTION_KEY=
