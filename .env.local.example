# Supabase project credentials — copy this file to .env.local and fill in.
# Find both values in the Supabase dashboard: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — powers AI brief generation at /intake (Step 4+).
# Without it, a deterministic local parser is used instead (same flow).
OPENAI_API_KEY=
# OPENAI_BRIEF_MODEL=gpt-4o-mini

# Optional — Sentry error tracking (Step 14+). From sentry.io: Project
# Settings → Client Keys (DSN). Unset = tracking fully inactive.
# SENTRY_DSN=

# Optional — invite email (Step 23, plain SMTP via the owner's own
# mail account). ALL FIVE must be set for invites to be emailed; any
# missing = silently skipped (copy-link flow, dev mode).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<App Password — regular passwords are rejected by Google>.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="NookScript <you@gmail.com>"


# Optional — Stripe billing for the Free → Pro upgrade (2026-09-26
# events/webhooks/billing phase). TEST-mode keys in development.
# STRIPE_SECRET_KEY + STRIPE_PRICE_ID: the in-app "Upgrade to Pro" button
# (hosted Stripe Checkout; one recurring price).
# STRIPE_WEBHOOK_SECRET + SUPABASE_SERVICE_ROLE_KEY: the
# /api/stripe/webhook endpoint (exactly two events:
# checkout.session.completed + customer.subscription.deleted).
# Any of these missing = the Plan card keeps the early-access mailto and
# nothing breaks. Full setup: docs/billing-webhooks-closeout.md.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=

# Optional — outbound-webhook retry sweep (serverless recovery for
# frozen in-process retries). Point any scheduler once per minute at:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#     https://<your-domain>/api/cron/webhooks
# Unset = the route returns 503 and the sweep never runs.
# CRON_SECRET=
